# Copy to .env beside compose.yaml and fill in. Keep .env out of git.

# The database's password. Letters and digits only, because it goes into
# a connection string. To make one:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Seals the keys you type into the app: 32 random bytes, base64. Make it
# once and keep it with your backups. Without it, a restored database's
# stored keys can't be read, and each one has to be typed in again.
#   openssl rand -base64 32
NILES_SECRET_KEY=

# The MQTT broker's login. Its address is in niles.toml.
NILES_MQTT_USERNAME=
NILES_MQTT_PASSWORD=

# Hearing and thinking. Niles needs both keys to start.
#   ElevenLabs: https://elevenlabs.io/app/settings/api-keys
#   Cerebras (has a free tier): https://cloud.cerebras.ai
ELEVENLABS_API_KEY=
CEREBRAS_API_KEY=

# The image. Unset means ghcr.io/marknygaard/niles:latest, the newest
# release. Pin a version to upgrade only when you choose to:
# NILES_IMAGE=ghcr.io/marknygaard/niles:0.4.0
