# KiCad's local state.
niles-satellite-pcb-v2/.history/
*.kicad_prl
*-backups/
fp-info-cache

# Written by the circuit scripts (SKiDL) on every run.
__pycache__/
*.erc
*.log
*_sklib.py
circuit/_test.net
circuit/_skidl_test.py
/topboard.net

# Regenerated by kicad-cli / scripts/export_order.py (gerbers.zip is kept).
order/gerbers/
order/pos_kicad.csv
niles-satellite-pcb-v2/*.step

# Third-party CAD: download it from the maker rather than re-publishing it here
# (SPEC.md, "Not in this repository"). Our own placeholder boxes are kept.
reference/
3d/*
!3d/*_box.step
