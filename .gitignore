# Rust build artifacts
/target
**/*.rs.bk

# The add-ons' own workspace, and the components addons/build.sh puts
# beside each manifest. A release builds them again. `niles plugin dev`
# keeps an add-on's storage in .niles-dev and reads its settings, which
# may hold a key, from dev-settings.toml.
/addons/target
/addons/*/integration.wasm
/addons/*/.niles-dev
/addons/*/dev-settings.toml

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Claude Code per-user state
.claude/settings.local.json

# Project MCP servers. Per-machine, and it names hosts that are nobody
# else's business on a public repo. The skills under .claude/skills are
# checked in; this is not.
.mcp.json

# Local-only Claude Code working notes (prior-art pointers, personal
# scratchpads, anything we don't want on the public repo). Auto-loaded
# alongside CLAUDE.md when present.
CLAUDE.local.md
ROADMAP.md

# OS
.DS_Store
Thumbs.db
desktop.ini

# Env files — never commit secrets
.env
.env.local
.env.*.local

# Niles runtime data (local Compose/dev volumes)
/niles-data
/mosquitto-data
/z2m-data

# Personal config file (copy from examples/niles.example.toml)
/niles.toml

# Logs
*.log

# Reference screenshots dropped in for a design discussion. Useful in
# the moment, not part of the project.
/Tado screenshots/

# The speaker-recognition model, exported by scripts/export-ecapa-onnx.py.
# 80 MB of weights that nothing diffs, in a public repo. It belongs on a
# release, which is where the image build fetches it from.
*.onnx
*.onnx.data

# Claude Code worktrees (local, per session).
.claude/worktrees/
